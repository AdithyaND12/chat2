# Copy to .env and fill in the keys you have. Every value is optional except a
# LLM provider key; the assistant degrades gracefully when a key is missing.

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# --- Speech-to-text ---
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram
OPENAI_API_KEY=

# --- Text-to-speech ---
EDGE_VOICE=en-US-AriaNeural

# --- Tools / data ---
GNEWS_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- Voice pipeline ---
WAKE_WORD=hey_jarvis
WAKE_WORD_SENSITIVITY=0.5
SILENCE_SECONDS=1.2
SAMPLE_RATE=16000

# --- Assistant ---
ASSISTANT_NAME=Nova
TIMEZONE=UTC
NOTIFICATIONS_ENABLED=true

# --- Storage ---
DB_PATH=data/assistant.db
CHECKPOINT_PATH=data/checkpoint.sqlite
LOG_LEVEL=INFO
